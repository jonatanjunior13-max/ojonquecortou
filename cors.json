[
  {
    "origin": ["*"],
    "method": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "X-Requested-With",
      "x-goog-resumable",
      "x-goog-content-length-range"
    ],
    "maxAgeSeconds": 3600
  }
]
