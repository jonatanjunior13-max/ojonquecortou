{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron-automations.js": {
      "maxDuration": 60
    },
    "api/cron-reminders.js": {
      "maxDuration": 60
    },
    "api/cron-blog.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/whatsapp-webhook(.*)",
      "dest": "/api/whatsapp-webhook.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/ad570ba1c6ba4630b664a7f571d247d0.txt",
      "dest": "/ad570ba1c6ba4630b664a7f571d247d0.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api|.*\\.txt$).*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "0 1 * * *" 
    },
    {
      "path": "/api/cron-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-automations",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/cron-daily-digest",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-blog",
      "schedule": "0 12 * * 1,5"
    }
  ]
}
