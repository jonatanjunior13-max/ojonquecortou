{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/newsletter-mailgun.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(self), payment=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://connect.facebook.net https://www.facebook.com https://*.facebook.net https://*.facebook.com https://analytics.ahrefs.com https://www.google.com https://*.google.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https://firebasestorage.googleapis.com https://*.firebasestorage.app; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://*.googleapis.com https://*.firebaseio.com https://analytics.ahrefs.com https://www.facebook.com https://*.facebook.net https://*.facebook.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://*.google.com https://*.doubleclick.net https://*.googleadservices.com https://ad.doubleclick.net; frame-src 'self' https://www.googletagmanager.com https://www.facebook.com https://td.doubleclick.net https://www.google.com https://*.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/(sw\\.js|registerSW\\.js)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/[^/]+\\.(png|jpe?g|webp|svg)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/jon-perfil\\.(jpg|webp)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/api/media/([^/]+)",
      "dest": "/api/media-proxy.js?file=$1"
    },
    {
      "src": "/blog/metodo-leitura-de-fio-antes-da-tesoura",
      "status": 301,
      "headers": { "Location": "/blog/leitura-de-fio-metodo-exclusivo-studio-do-jon" }
    },
    {
      "src": "/blog/corte-hibrido-cachos-seco-molhado",
      "status": 301,
      "headers": { "Location": "/servicos/corte-hibrido" }
    },
    {
      "src": "/blog/cortes-cacheados-2026",
      "status": 301,
      "headers": { "Location": "/servicos" }
    },
    {
      "src": "/blog/rotina-basica-cabelo-cacheado-cronograma",
      "status": 301,
      "headers": { "Location": "/blog/cronograma-capilar-cabelo-cacheado" }
    },
    {
      "src": "/blog/fator-encolhimento-cabelo-cacheado",
      "status": 301,
      "headers": { "Location": "/blog/fator-encolhimento-cabelo-cacheado-fisica-geometria" }
    },
    {
      "src": "/blog/fim-do-bad-hair-day-after",
      "status": 301,
      "headers": { "Location": "/blog/day-after-cabelo-cacheado-bh-como-reativar-sem-lavar" }
    },
    {
      "src": "/blog/transicao-capilar-scab-hair-guia-fio-sem-forma",
      "status": 301,
      "headers": { "Location": "/blog/guia-completo-transicao-capilar-cabelo-natural" }
    },
    {
      "src": "/blog/transicao-capilar-sem-sofrimento-guia-cachos",
      "status": 301,
      "headers": { "Location": "/blog/guia-completo-transicao-capilar-cabelo-natural" }
    },
    {
      "src": "/blog/transicao-capilar-bh-danos-botox",
      "status": 301,
      "headers": { "Location": "/blog/guia-completo-transicao-capilar-cabelo-natural" }
    },
    {
      "src": "/blog/transicao-capilar-bh-corte-seco",
      "status": 301,
      "headers": { "Location": "/blog/guia-completo-transicao-capilar-cabelo-natural" }
    },
    {
      "src": "/blog/frizz-em-cabelo-cacheado",
      "status": 301,
      "headers": { "Location": "/blog/guia-completo-frizz-cabelo-cacheado" }
    },
    {
      "src": "/blog/voce-tem-cabelo-ondulado-e-nao-sabe-liso-com-frizz",
      "status": 301,
      "headers": { "Location": "/blog/guia-completo-frizz-cabelo-cacheado" }
    },
    {
      "src": "/blog/frizz-normal-ou-dano-capilar",
      "status": 301,
      "headers": { "Location": "/blog/guia-completo-frizz-cabelo-cacheado" }
    },
    {
      "src": "/blog/guia-sobrevivencia-frizz-bh",
      "status": 301,
      "headers": { "Location": "/blog/cabelo-cacheado-inverno-bh-frizz-ressecamento" }
    },
    {
      "src": "/sobre-o-jon",
      "status": 301,
      "headers": { "Location": "/sobre" }
    },
    {
      "src": "/metodologia",
      "status": 301,
      "headers": { "Location": "/metodo" }
    },
    {
      "src": "/servicos/visagismo-cacheado",
      "status": 301,
      "headers": { "Location": "/servicos/visagismo-cachos" }
    },
    {
      "src": "/servicos/tratamento-personalizado(/)?$",
      "dest": "/index.html"
    },
    {
      "src": "/api/indexnow",
      "dest": "/api/cron.js?task=indexnow"
    },
    {
      "src": "/api/cron-reminders",
      "dest": "/api/cron.js?task=reminders"
    },
    {
      "src": "/api/cron-automations",
      "dest": "/api/cron.js?task=automations"
    },
    {
      "src": "/api/cron-daily-digest",
      "dest": "/api/cron.js?task=daily-digest"
    },
    {
      "src": "/api/cron-blog",
      "dest": "/api/cron.js?task=blog"
    },
    {
      "src": "/api/whatsapp-webhook(.*)",
      "dest": "/api/whatsapp-webhook.js"
    },
    {
      "src": "/api/whatsapp/?$",
      "dest": "/api/whatsapp-webhook.js"
    },
    {
      "src": "/api/instagram",
      "dest": "/api/meta-capi.js?action=instagram"
    },
    {
      "src": "/api/mailgun-webhook",
      "dest": "/api/newsletter-mailgun.js?action=webhook"
    },
    {
      "src": "/api/unsubscribe",
      "dest": "/api/newsletter-mailgun.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/2778862fb97f435e968549a6ef8f4f05.txt",
      "dest": "/2778862fb97f435e968549a6ef8f4f05.txt"
    },
    {
      "src": "/products-feed.xml",
      "dest": "/api/products.js?action=feed"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/blog/([^/]+)/?",
      "dest": "/blog/$1/index.html"
    },
    {
      "src": "/servicos/([^/]+)/?",
      "dest": "/servicos/$1/index.html"
    },
    {
      "src": "/(sobre|servicos|galeria|depoimentos|blog|faq|metodo|investimento|imprensa)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/admin(/(.*))?",
      "dest": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "src": "/cliente/?",
      "dest": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "src": "/(agendar|cancelar|cachos|glossario|produtos(/[^/]+)?)/?",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?task=daily",
      "schedule": "0 12 * * *"
    }
  ]
}
