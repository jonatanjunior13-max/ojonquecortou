{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ojonquecortou.com.br"
        }
      ],
      "destination": "https://www.ojonquecortou.com.br/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=()" }
      ]
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/newsletter-mailgun.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/media/([^/]+)",
      "dest": "/api/media-proxy.js?file=$1"
    },
    {
      "src": "/blog/metodo-leitura-de-fio-antes-da-tesoura",
      "status": 301,
      "headers": { "Location": "/blog/leitura-de-fio-metodo-exclusivo-studio-do-jon" }
    },
    {
      "src": "/blog/corte-hibrido-cachos-seco-molhado",
      "status": 301,
      "headers": { "Location": "/servicos/corte-hibrido" }
    },
    {
      "src": "/blog/cortes-cacheados-2026",
      "status": 301,
      "headers": { "Location": "/servicos" }
    },
    {
      "src": "/metodologia",
      "status": 301,
      "headers": { "Location": "/metodo" }
    },
    {
      "src": "/api/indexnow",
      "dest": "/api/cron.js?task=indexnow"
    },
    {
      "src": "/api/cron-reminders",
      "dest": "/api/cron.js?task=reminders"
    },
    {
      "src": "/api/cron-automations",
      "dest": "/api/cron.js?task=automations"
    },
    {
      "src": "/api/cron-daily-digest",
      "dest": "/api/cron.js?task=daily-digest"
    },
    {
      "src": "/api/cron-blog",
      "dest": "/api/cron.js?task=blog"
    },
    {
      "src": "/api/whatsapp-webhook(.*)",
      "dest": "/api/whatsapp-webhook.js"
    },
    {
      "src": "/api/whatsapp/?$",
      "dest": "/api/whatsapp-webhook.js"
    },
    {
      "src": "/api/unsubscribe",
      "dest": "/api/newsletter-mailgun.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/2778862fb97f435e968549a6ef8f4f05.txt",
      "dest": "/2778862fb97f435e968549a6ef8f4f05.txt"
    },
    {
      "src": "/products-feed.xml",
      "dest": "/api/products.js?action=feed"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|css|js|ico|map|xml|txt)$",
      "status": 404
    },
    {
      "src": "/blog/([^/]+)/?",
      "dest": "/blog/$1/index.html"
    },
    {
      "src": "/servicos/([^/]+)/?",
      "dest": "/servicos/$1/index.html"
    },
    {
      "src": "/(sobre|servicos|galeria|depoimentos|blog|faq|metodo|investimento)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/((?!api|.*\\.(txt|webp|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot|mp4|webm|json|xml|pdf|csv|zip)$).*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "0 1 * * *" 
    },
    {
      "path": "/api/cron-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-automations",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/cron-daily-digest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-blog",
      "schedule": "0 12 * * *"
    }
  ]
}
