rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Galeria de fotos do salão — somente admin autenticado pode fazer upload
    match /gallery/{filename} {
      allow read: if true;           // Qualquer um pode ver (galeria pública)
      allow write: if request.auth != null;  // Somente autenticado pode fazer upload/delete
    }

    // Qualquer outro arquivo — somente autenticado
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
