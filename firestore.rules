rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ============================
    // AGENDAMENTOS (bookings)
    // Leitura restrita: somente por quem criou OU admin autenticado
    // ============================
    match /bookings/{bookingId} {
      allow create: if request.auth != null; // requer autenticação (anônima ou real)
      allow read, update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // ============================
    // PERFIS DE CLIENTES (client_profiles)
    // Requer autenticação para criar (anônima ou real)
    // Público pode ler/atualizar o próprio perfil pelo userId
    // Admin autenticado pode tudo
    // ============================
    match /client_profiles/{phone} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ============================
    // SERVIÇOS (services)
    // Qualquer um pode ler (exibição pública no catálogo)
    // Só admin autenticado pode escrever
    // ============================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================
    // PRODUTOS / ESTOQUE (products)
    // Só admin autenticado pode ler e escrever
    // ============================
    match /products/{productId} {
      allow read, write: if isAdmin();
    }

    // ============================
    // TRANSAÇÕES FINANCEIRAS (financial_transactions)
    // Só admin autenticado
    // ============================
    match /financial_transactions/{txId} {
      allow read, write: if isAdmin();
    }

    // ============================
    // CONFIGURAÇÕES DO STUDIO (settings)
    // Só admin autenticado
    // ============================
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ============================
    // CUPONS E GIFT CARDS
    // ============================
    match /coupons/{couponId} {
      allow read: if true; // validação pública
      allow write: if isAdmin();
    }

    match /giftcards/{gcId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
