rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // AGENDAMENTOS (bookings)
    // ============================
    match /bookings/{bookingId} {
      allow create, read: if true; // público pode agendar e ler
      allow update: if true; // permite webhook atualizar status
      allow delete: if request.auth != null; // admin autenticado
    }

    // ============================
    // PERFIS DE CLIENTES (client_profiles)
    // Público pode criar (auto-cadastro)
    // Público pode ler o próprio perfil pelo userId (para a página do cliente)
    // Serverless functions (sem auth) precisam ler para checar opt-out
    // Admin autenticado pode tudo
    // ============================
    match /client_profiles/{phone} {
      allow create: if true;
      // Permite leitura: admin logado OU dono do perfil OU leitura pública
      // (necessário para API serverless verificar opt-out de email)
      allow read: if true;
      allow update: if request.auth != null
        || resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // ============================
    // SERVIÇOS (services)
    // ============================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // PRODUTOS / ESTOQUE (products)
    // ============================
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // TRANSAÇÕES FINANCEIRAS (financial_transactions)
    // ============================
    match /financial_transactions/{txId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // CONFIGURAÇÕES DO STUDIO (settings)
    // Leitura pública necessária (BookingPage, API serverless)
    // ============================
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================
    // CUPONS E GIFT CARDS
    // ============================
    match /coupons/{couponId} {
      allow read: if true; // validação pública
      allow write: if request.auth != null;
    }

    match /giftcards/{gcId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // GALERIA DE FOTOS (gallery_photos)
    // ============================
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // LOGS DE AUTOMAÇÃO E NOTIFICAÇÕES
    // API serverless precisa escrever em admin_notifications sem auth
    // ============================
    match /automation_logs/{logId} {
      allow read, write: if true;
    }

    match /admin_notifications/{notifId} {
      // Serverless functions precisam criar notificações (sem auth de usuário)
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ============================
    // BLOG POSTS (blog_posts)
    // ============================
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // SALON PRODUCTS / INSUMOS
    // ============================
    match /salon_products/{productId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // GBP POSTS (gbp_posts)
    // ============================
    match /gbp_posts/{postId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // PACKAGES (pacotes e créditos de clientes)
    // ============================
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /client_packages/{cpId} {
      // Cliente precisa ler seus próprios pacotes no agendamento
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // NEWSLETTER SENDS
    // ============================
    match /newsletter_sends/{sendId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // SERVICOS (alias)
    // ============================
    match /servicos/{sId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
