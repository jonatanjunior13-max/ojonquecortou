rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // AGENDAMENTOS (bookings)
    // Qualquer pessoa pode criar um agendamento (cliente público)
    // Leitura restrita: somente por quem criou OU admin autenticado
    // ============================
    match /bookings/{bookingId} {
      allow create, read: if true; // público pode agendar e ler
      allow update: if true; // permite webhook atualizar status
      allow delete: if request.auth != null; // admin autenticado
    }

    // ============================
    // PERFIS DE CLIENTES (client_profiles)
    // Público pode criar (auto-cadastro no agendamento)
    // Público pode ler/atualizar o próprio perfil pelo userId
    // Admin autenticado pode tudo
    // ============================
    match /client_profiles/{phone} {
      allow create: if true;
      allow read, update: if request.auth != null
        || (request.auth != null && resource.data.userId == request.auth.uid)
        || resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // ============================
    // SERVIÇOS (services)
    // Qualquer um pode ler (exibição pública no catálogo)
    // Só admin autenticado pode escrever
    // ============================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // PRODUTOS / ESTOQUE (products)
    // Qualquer um pode ler (exibição pública no catálogo)
    // Só admin autenticado pode escrever
    // ============================
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // TRANSAÇÕES FINANCEIRAS (financial_transactions)
    // Só admin autenticado
    // ============================
    match /financial_transactions/{txId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // CONFIGURAÇÕES DO STUDIO (settings)
    // Só admin autenticado
    // ============================
    match /settings/{docId} {
      allow read, write: if true;
    }

    // ============================
    // CUPONS E GIFT CARDS
    // ============================
    match /coupons/{couponId} {
      allow read: if true; // validação pública
      allow write: if request.auth != null;
    }

    match /giftcards/{gcId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // GALERIA DE FOTOS (gallery_photos)
    // Leitura pública (galeria exibida no site)
    // Escrita só admin autenticado
    // ============================
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // LOGS DE AUTOMAÇÃO E NOTIFICAÇÕES (automation_logs / admin_notifications)
    // Só admin autenticado
    // ============================
    match /automation_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /admin_notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // BLOG POSTS (blog_posts)
    // ============================
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================
    // SALON PRODUCTS (salon_products) / INSUMOS
    // ============================
    match /salon_products/{productId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // PACKAGES (packages / client_packages)
    // ============================
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /client_packages/{cpId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // NEWSLETTER SENDS (newsletter_sends)
    // ============================
    match /newsletter_sends/{sendId} {
      allow read, write: if request.auth != null;
    }

    // ============================
    // SERVICOS (servicos)
    // ============================
    match /servicos/{sId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
